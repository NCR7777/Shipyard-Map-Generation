{
  "name": "yard-spatial-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "schema:generate": "node scripts/generate-types.mjs",
    "schema:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run tests/unit --exclude .cache/**",
    "test:integration": "vitest run tests/integration --exclude .cache/**",
    "test:e2e": "playwright test",
    "test:production": "playwright test -c playwright.production.config.ts",
    "map:diagnose": "tsx scripts/map-diagnose.ts",
    "map:validate": "tsx scripts/map-validate.ts",
    "map:migrate": "tsx scripts/map-migrate.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "js-sha256": "1.0.0",
    "jsonc-parser": "3.3.1",
    "konva": "10.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
