{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shipyard:spatial-classification:1.0",
  "title": "org.shipyard.spatial_classification metadata payload 1.0",
  "description": "Root catalog or entity annotation. Collection scope, custom-class references and source existence are checked against the owning map.",
  "oneOf": [{ "$ref": "#/$defs/catalog" }, { "$ref": "#/$defs/zoneAnnotation" }],
  "$defs": {
    "classId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "not": { "enum": ["constructor", "prototype", "__proto__"] } },
    "definition": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "appliesTo"],
      "properties": {
        "id": { "$ref": "#/$defs/classId" },
        "label": { "type": "string", "maxLength": 80, "pattern": "\\S" },
        "appliesTo": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["facilities", "zones"] } }
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["customClasses"],
      "properties": { "customClasses": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/definition" } } }
    },
    "depth": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "value", "sourceRef"], "properties": { "state": { "const": "known" }, "value": { "type": "number", "exclusiveMinimum": 0 }, "sourceRef": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "unknown" }, "reason": { "type": "string", "maxLength": 2000, "pattern": "\\S" } } }
      ]
    },
    "buildingAnnotation": {
      "type": "object", "additionalProperties": false, "required": ["classId"],
      "properties": { "classId": { "$ref": "#/$defs/classId" } }
    },
    "zoneAnnotation": {
      "type": "object", "additionalProperties": false, "required": ["classId"],
      "properties": {
        "classId": { "$ref": "#/$defs/classId" }, "depthM": { "$ref": "#/$defs/depth" },
        "depthReference": { "type": "string", "maxLength": 200, "pattern": "\\S" }
      },
      "allOf": [{ "if": { "required": ["depthM"], "properties": { "depthM": { "type": "object", "required": ["state"], "properties": { "state": { "const": "known" } } } } }, "then": { "properties": { "depthReference": {} }, "required": ["depthReference"] } }]
    }
  }
}
