{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts/*.ts", "tests", "vite.config.ts", "playwright.config.ts", "playwright.production.config.ts"]
}
